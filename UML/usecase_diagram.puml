
@startuml
left to right direction
skinparam packageStyle rectangle

actor "Visiteur" as V
actor "Utilisateur connecté" as U

U --|> V

rectangle "Application d'échange de compétences" {

  usecase "S'authentifier" as UC0

  usecase "Consulter la liste\ndes compétences" as UC1

  usecase "Consulter les créneaux\nd'aide proposés\n(affichage anonyme)" as UC2

  usecase "Indiquer ses\ncompétences" as UC3

  usecase "Renseigner ses\ndisponibilités" as UC4

  usecase "Créer une\ndemande d'aide" as UC5

  usecase "Consulter les demandes\nd'aide compatibles avec\nses compétences" as UC6

  usecase "Se proposer pour\naider sur un créneau" as UC7

  usecase "Rendre le créneau\nindisponible pour\nd'autres propositions" as UC8
}

V --> UC0
V --> UC1
V --> UC2

U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7

UC7 ..> UC8 : <<include>>

note bottom of U
  Précondition :
  l'utilisateur doit être
  authentifié pour accéder
  aux cas d'utilisation
  qui lui sont associés.
end note

@enduml
  